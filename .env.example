<?php
/**
 * .env.example - Konfigürasyon Örneği
 * Bilgilerinizi buraya yazıp .env dosyası olarak kaydedin
 */

# Veritabanı Ayarları
DB_HOST=localhost
DB_NAME=yuknet_db
DB_USER=root
DB_PASSWORD=

# Email Ayarları (Gelecek için)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Site Ayarları
SITE_URL=http://localhost
SITE_NAME=Yuknet - Nakliyeler
ADMIN_EMAIL=admin@yuknet.com

# Güvenlik Ayarları
SESSION_TIMEOUT=604800
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_TIMEOUT=900

# Development/Production
ENVIRONMENT=development
DEBUG=true
